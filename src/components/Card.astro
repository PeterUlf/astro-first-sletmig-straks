---
// const header = Astro.props.header;
// const text = Astro.props.text;
const { header } = Astro.props;
---

<article>
  <h2>{header}</h2>
  <p>Fællestekst for alle cards</p>
  <div class="carddesign">
    <slot />
  </div>
</article>

<style>
  article {
    border: 1px solid black;
  }
  p,
  .carddesign :global(p) {
    color: white;
  }
</style>
